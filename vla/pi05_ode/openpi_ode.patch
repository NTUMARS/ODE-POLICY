+++ b/src/openpi/policies/libero_policy.py
@@ -73,6 +73,8 @@ class LiberoInputs(transforms.DataTransformFn):
         # Actions are only available during training.
         if "actions" in data:
             inputs["actions"] = data["actions"]
+        if "actions_is_pad" in data:
+            inputs["action_valid_mask"] = ~np.asarray(data["actions_is_pad"], dtype=bool)
 
         # Pass the prompt (aka language instruction) to the model.
         # Keep this for your own dataset (but modify the key if the instruction is not
@@ -98,3 +100,20 @@ class LiberoOutputs(transforms.DataTransformFn):
         # For Libero, we only return the first 7 actions (since the rest is padding).
         # For your own dataset, replace `7` with the action dimension of your dataset.
         return {"actions": np.asarray(data["actions"][..., :7])}
+
+
+@dataclasses.dataclass(frozen=True)
+class LiberoODEInputs(LiberoInputs):
+    """LIBERO inputs for the ODE head: sign-continuous proprioception and the reference start."""
+
+    def __call__(self, data):
+        # Supplied by the training cache or, at inference, by the per-episode client state.
+        # Fail closed rather than accidentally reading the raw axis-angle state as a quaternion.
+        if "ode_proprio" not in data or "ode_start" not in data:
+            raise ValueError("ODE requires explicit proprioception and per-episode reference start")
+        result = super().__call__(data)
+        result["state"] = np.asarray(data["ode_proprio"], dtype=np.float32)
+        result["ode_start"] = np.asarray(data["ode_start"], dtype=np.float32)
+        if result["state"].shape != (8,) or result["ode_start"].shape != (6,):
+            raise ValueError("Invalid unbatched ODE proprioception/reference shape")
+        return result
