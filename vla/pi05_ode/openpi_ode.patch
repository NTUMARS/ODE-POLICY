diff --git a/src/openpi/models/ode_field.py b/src/openpi/models/ode_field.py
new file mode 100644
index 0000000..2baa77d
--- /dev/null
+++ b/src/openpi/models/ode_field.py
@@ -0,0 +1,99 @@
+"""JAX port of the ODE policy's vector field (ode_policy/policies/ode/ode_image_policy.py),
+without the optional diversity head.
+
+Inputs/outputs are normalized poses. Time unit is one controller step, not
+flow time or wall-clock seconds. Condition and proprioception stay fixed.
+"""
+from flax import nnx
+import dataclasses
+import jax
+import jax.numpy as jnp
+
+
+@dataclasses.dataclass(frozen=True)
+class AuthorUniform:
+    bound: float
+
+    def __call__(self, key, shape, dtype=jnp.float32):
+        return jax.random.uniform(key, shape, dtype, minval=-self.bound, maxval=self.bound)
+
+
+def author_linear(in_features, out_features, *, rngs, zero=False):
+    """PyTorch Linear default distribution, or author's zero output projection."""
+    # NNX stores the initializer as static graph metadata. A closure created on
+    # every init would make eval_shape and actual init graph definitions unequal.
+    init = jax.nn.initializers.zeros if zero else AuthorUniform(in_features ** -0.5)
+    return nnx.Linear(in_features, out_features, kernel_init=init, bias_init=init, rngs=rngs)
+
+
+class GripperHead(nnx.Module):
+    """Author's Linear(C,C) -> SiLU -> Linear(C,H), not a linear classifier."""
+    def __init__(self, cond_dim, horizon, *, rngs):
+        self.hidden = author_linear(cond_dim, cond_dim, rngs=rngs)
+        self.output = author_linear(cond_dim, horizon, rngs=rngs)
+
+    def __call__(self, c):
+        return self.output(jax.nn.silu(self.hidden(c)))
+
+
+class FiLMLayer(nnx.Module):
+    def __init__(self, width, cond_dim, *, rngs):
+        self.lin = author_linear(width, width, rngs=rngs)
+        self.film = author_linear(cond_dim, 2 * width, rngs=rngs)
+
+    def __call__(self, h, gb):
+        gain, bias = gb
+        return h + jax.nn.silu(self.lin(h) * (1 + gain) + bias)
+
+
+class VectorField(nnx.Module):
+    def __init__(self, cond_dim, state_dim, width, *, rngs, num_layers=4):
+        self.inp = author_linear(6 + state_dim, width, rngs=rngs)
+        # String-keyed modules keep compatibility with OpenPI's slash-key loader.
+        self.layers = nnx.Dict({f'layer_{i}': FiLMLayer(width, cond_dim, rngs=rngs) for i in range(num_layers)})
+        self.out = author_linear(width, 6, zero=True, rngs=rngs)
+
+    def precompute(self, c):
+        return [jnp.split(layer.film(c), 2, axis=-1) for layer in self.layers.values()]
+
+    def __call__(self, a, s, film):
+        h = self.inp(jnp.concatenate([a, s], axis=-1))
+        for layer, gb in zip(self.layers.values(), film, strict=True):
+            h = layer(h, gb)
+        return self.out(h)
+
+
+def integrate(field, a0, s, c, *, horizon=8, vel_scale=0.05):
+    """Fixed-condition RK4, exactly four field calls per control step."""
+    film = field.precompute(c)
+
+    def step(a, _):
+        f = lambda x: vel_scale * field(x, s, film)
+        k1 = f(a)
+        k2 = f(a + 0.5 * k1)
+        k3 = f(a + 0.5 * k2)
+        k4 = f(a + k3)
+        a = a + (k1 + 2 * k2 + 2 * k3 + k4) / 6
+        return a, a
+
+    _, path = jax.lax.scan(step, a0, None, length=horizon)
+    return jnp.swapaxes(path, 0, 1)
+
+
+def perturb_targets(key, a0, target, pose_scale):
+    """Author's physical 1cm/0.03rad perturbation converted to norm units."""
+    gate_key, noise_key = jax.random.split(key)
+    on = jax.random.bernoulli(gate_key, 0.5, (a0.shape[0], 1))
+    std = jnp.array([0.01] * 3 + [0.03] * 3) * pose_scale
+    delta = jax.random.normal(noise_key, a0.shape) * std * on
+    decay = 0.7 ** jnp.arange(1, target.shape[1] + 1)
+    return a0 + delta, target + delta[:, None] * decay[None, :, None]
+
+
+def path_loss(path, target, grip_logits, grip_target, valid, *, vel_scale=0.05):
+    """Per-example loss; padding contributes neither pose nor gripper loss."""
+    pose = jnp.mean(jnp.square((path - target) / vel_scale), axis=-1)
+    labels = (grip_target > 0).astype(grip_logits.dtype)
+    bce = jax.nn.softplus(grip_logits) - labels * grip_logits
+    loss = jnp.where(valid, pose + 0.1 * bce, 0)
+    return jnp.sum(loss, axis=-1) / jnp.maximum(jnp.sum(valid, axis=-1), 1)
diff --git a/src/openpi/models/ode_field_test.py b/src/openpi/models/ode_field_test.py
new file mode 100644
index 0000000..907a78b
--- /dev/null
+++ b/src/openpi/models/ode_field_test.py
@@ -0,0 +1,87 @@
+"""Compare the PyTorch ODE policy's classes (this repository) against the JAX port on CPU."""
+import ast
+import os
+from pathlib import Path
+
+from flax import nnx
+import jax
+import jax.numpy as jnp
+import numpy as np
+import torch
+
+from openpi.models.ode_field import VectorField, integrate, path_loss, perturb_targets
+
+
+def _author_policy_file():
+    """ode_policy/policies/ode/ode_image_policy.py of this repository (the PyTorch reference)."""
+    root = Path(os.environ.get("ODE_POLICY_ROOT", Path(__file__).resolve().parents[6]))
+    return root / "ode_policy/policies/ode/ode_image_policy.py"
+
+
+def author_classes():
+    source = _author_policy_file()
+    tree = ast.parse(source.read_text())
+    # Compile unmodified class definitions, avoiding unrelated vision/env imports.
+    nodes = [n for n in tree.body if isinstance(n, ast.ClassDef) and n.name in ("_FiLMLayer", "VectorField")]
+    scope = {"torch": torch, "nn": torch.nn, "F": torch.nn.functional, "POSE_DIM": 6}
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), str(source), "exec"), scope)
+    return scope["VectorField"]
+
+
+def test_author_field_rk4_and_input_gradient():
+    torch.manual_seed(42)
+    author = author_classes()(5, 8, 12, 4)
+    # Nonzero output necessary to test every layer, not a trivially constant path.
+    torch.nn.init.normal_(author.out.weight, std=0.02)
+    port = VectorField(5, 8, 12, rngs=nnx.Rngs(42))
+    pairs = [(author.inp, port.inp), (author.out, port.out)]
+    for a, b in zip(author.layers, port.layers.values(), strict=True):
+        pairs.extend([(a.lin, b.lin), (a.film, b.film)])
+    for a, b in pairs:
+        b.kernel.value = jnp.asarray(a.weight.detach().numpy().T)
+        b.bias.value = jnp.asarray(a.bias.detach().numpy())
+    rng = np.random.default_rng(42)
+    a, s, c = [rng.normal(size=(2, d)).astype(np.float32) for d in (6, 8, 5)]
+    ta, ts, tc = [torch.tensor(x, requires_grad=True) for x in (a, s, c)]
+    film = author.precompute(tc)
+    x, states = ta, []
+    for _ in range(8):
+        f = lambda z: 0.05 * author(z, ts, tc, film)
+        k1 = f(x)
+        k2 = f(x + 0.5 * k1)
+        k3 = f(x + 0.5 * k2)
+        k4 = f(x + k3)
+        x = x + (k1 + 2*k2 + 2*k3 + k4)/6
+        states.append(x)
+    expected = torch.stack(states, dim=1)
+    actual = integrate(port, jnp.array(a), jnp.array(s), jnp.array(c))
+    np.testing.assert_allclose(actual, expected.detach(), atol=2e-6, rtol=2e-5)
+    expected.square().mean().backward()
+    grads = jax.grad(lambda a, s, c: jnp.mean(integrate(port, a, s, c)**2), argnums=(0, 1, 2))(a, s, c)
+    for got, ref in zip(grads, (ta.grad, ts.grad, tc.grad), strict=True):
+        np.testing.assert_allclose(got, ref, atol=2e-6, rtol=2e-5)
+    parameter_grads=nnx.grad(lambda field:jnp.mean(integrate(field,a,s,c)**2))(port).to_pure_dict()
+    for name,parameter in author.named_parameters():
+        keys=name.split('.')
+        if keys[0]=='layers':
+            keys[1]='layer_'+keys[1]
+        transpose=keys[-1]=='weight'
+        keys[-1]='kernel' if transpose else 'bias'
+        got=parameter_grads
+        for key in keys:
+            got=got[key]
+        ref=parameter.grad.detach().numpy()
+        np.testing.assert_allclose(got,ref.T if transpose else ref,atol=2e-6,rtol=3e-5)
+
+
+def test_zero_initialization_mask_and_perturbation():
+    field = VectorField(5, 8, 12, rngs=nnx.Rngs(0))
+    a = jnp.ones((2, 6))
+    path = integrate(field, a, jnp.ones((2, 8)), jnp.ones((2, 5)))
+    np.testing.assert_array_equal(path, np.ones((2, 8, 6)))
+    target = path.at[:, 1:].set(100)
+    valid = jnp.zeros((2, 8), dtype=bool).at[:, 0].set(True)
+    loss = path_loss(path, target, jnp.zeros((2, 8)), jnp.ones((2, 8)), valid)
+    np.testing.assert_allclose(loss, 0.1*np.log(2), atol=1e-7)
+    a0, tgt = perturb_targets(jax.random.key(42), a, path, jnp.ones(6))
+    np.testing.assert_allclose(tgt-path, (a0-a)[:, None]*0.7**jnp.arange(1, 9)[None, :, None], atol=1e-7)
