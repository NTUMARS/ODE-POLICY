diff --git a/src/openpi/models/pi05_ode.py b/src/openpi/models/pi05_ode.py
new file mode 100644
index 0000000..5d7202a
--- /dev/null
+++ b/src/openpi/models/pi05_ode.py
@@ -0,0 +1,103 @@
+"""Pi0.5 with an ODE action head: an autonomous velocity field integrated with RK4 (no flow time).
+
+Pi05ODE keeps the action expert as a condition network (one learned query token);
+Pi05ODEVLMQuery (pi05_ode_vlmquery.py) drops the expert and reads the condition from the VLM.
+"""
+import dataclasses
+
+from flax import nnx
+from flax.nnx import bridge
+import jax
+import jax.numpy as jnp
+
+from openpi.models import gemma, model, ode_field, pi0, pi0_config, siglip
+from openpi.shared import array_typing as at
+
+
+@dataclasses.dataclass(frozen=True)
+class Pi05ODEConfig(pi0_config.Pi0Config):
+    pi05: bool = True
+    discrete_state_input: bool = False
+    action_horizon: int = 8
+    field_width: int = 512
+
+    def __post_init__(self):
+        super().__post_init__()
+        if not self.pi05 or self.discrete_state_input:
+            raise ValueError("The ODE head requires pi05 and no state tokens")
+        if self.action_horizon != 8:
+            raise ValueError("The ODE head integrates chunks of 8 control steps")
+
+    def create(self, rng):
+        return Pi05ODE(self, nnx.Rngs(rng))
+
+    def inputs_spec(self, *, batch_size=1):
+        obs, actions = super().inputs_spec(batch_size=batch_size)
+        with at.disable_typechecking():
+            return dataclasses.replace(
+                obs,
+                ode_start=jax.ShapeDtypeStruct((batch_size, 6), jnp.float32),
+                ode_pose_scale=jax.ShapeDtypeStruct((batch_size, 6), jnp.float32),
+                action_valid_mask=jax.ShapeDtypeStruct((batch_size, self.action_horizon), jnp.bool_),
+            ), actions
+
+
+class Pi05ODE(model.BaseModel):
+    # Same image/language embedding path and checkpoint names as Pi0.
+    embed_prefix = pi0.Pi0.embed_prefix
+
+    def __init__(self, config, rngs):
+        super().__init__(config.action_dim, config.action_horizon, config.max_token_len)
+        vlm = gemma.get_config(config.paligemma_variant)
+        expert = gemma.get_config(config.action_expert_variant)
+        llm = bridge.ToNNX(gemma.Module(configs=[vlm, expert], embed_dtype=config.dtype, adarms=True))
+        llm.lazy_init(rngs=rngs, method="init", use_adarms=[False, True])
+        img = bridge.ToNNX(siglip.Module(
+            num_classes=vlm.width, variant="So400m/14", pool_type="none", scan=True, dtype_mm=config.dtype,
+        ))
+        img.lazy_init(next(iter(config.fake_obs().images.values())), train=False, rngs=rngs)
+        self.PaliGemma = nnx.Dict(llm=llm, img=img)
+        self.query = nnx.Param(jax.random.normal(rngs.params(), (1, 1, expert.width)) * 0.02)
+        # Initialized from official time MLP by strict one-time weight migration.
+        self.z_ada = nnx.Param(jnp.zeros((expert.width,), jnp.float32))
+        self.field = ode_field.VectorField(expert.width, 8, config.field_width, rngs=rngs)
+        self.grip_head = ode_field.GripperHead(expert.width, 8, rngs=rngs)
+        self.deterministic = True
+
+    def condition(self, observation):
+        prefix, prefix_mask, prefix_ar = self.embed_prefix(observation)
+        batch = prefix.shape[0]
+        query = jnp.broadcast_to(self.query.value, (batch, 1, self.query.shape[-1]))
+        mask = jnp.concatenate([prefix_mask, jnp.ones((batch, 1), bool)], axis=1)
+        ar = jnp.concatenate([prefix_ar, jnp.ones((1,), bool)])
+        (_, suffix), _ = self.PaliGemma.llm(
+            [prefix, query], mask=pi0.make_attn_mask(mask, ar),
+            positions=jnp.cumsum(mask, axis=1)-1,
+            adarms_cond=[None, jnp.broadcast_to(self.z_ada.value, (batch, self.z_ada.shape[0]))],
+        )
+        return suffix[:, 0].astype(jnp.float32)
+
+    def compute_loss(self, rng, observation, actions, *, train=False):
+        if observation.ode_start is None or observation.ode_pose_scale is None:
+            raise ValueError("ODE training requires reference start and pose normalization slope")
+        if observation.action_valid_mask is None:
+            raise ValueError("ODE training requires explicit episode padding mask")
+        aug_key, perturb_key = jax.random.split(rng)
+        obs = model.preprocess_observation(aug_key, observation, train=train)
+        c = self.condition(obs)
+        a0, target = obs.ode_start, actions[..., :6]
+        if train:
+            a0, target = ode_field.perturb_targets(perturb_key, a0, target, obs.ode_pose_scale)
+        path = ode_field.integrate(self.field, a0, obs.state[..., :8], c)
+        return ode_field.path_loss(path, target, self.grip_head(c), actions[..., 6], obs.action_valid_mask)
+
+    def sample_actions(self, rng, observation):
+        del rng  # Pure ODE is deterministic; no FM source noise.
+        if observation.ode_start is None:
+            raise ValueError("Client must supply per-episode reference start")
+        obs = model.preprocess_observation(None, observation, train=False)
+        c = self.condition(obs)
+        path = ode_field.integrate(self.field, obs.ode_start, obs.state[..., :8], c)
+        grip = jnp.where(self.grip_head(c) >= 0, 1., -1.)
+        actions = jnp.concatenate([path, grip[..., None]], axis=-1)
+        return jnp.pad(actions, ((0, 0), (0, 0), (0, self.action_dim-7)))
