+++ b/src/openpi/models/pi05_ode_vlmquery_test.py
@@ -0,0 +1,68 @@
+from types import SimpleNamespace
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+from flax import nnx
+from flax.nnx import bridge
+from openpi.models import gemma,pi0
+from openpi.models.pi05_ode_vlmquery import Pi05ODEVLMQuery,Pi05ODEVLMQueryConfig
+from openpi.training.vlmquery_weight_loader import migrate
+from openpi.training.ode_weight_loader import REMOVED
+from flax.traverse_util import unflatten_dict
+
+def test_production_condition_uses_single_vlm_stream_and_no_state():
+    prefix=jnp.arange(4*2048,dtype=jnp.float32).reshape(1,4,2048)*1e-4
+    valid=jnp.array([[True,True,False,True]])
+    calls=[]
+    def llm(xs,*,mask,positions):
+        assert len(xs)==1 and xs[0].shape==(1,5,2048)
+        assert not np.asarray(mask)[0,:4,4].any()
+        np.testing.assert_array_equal(np.asarray(mask)[0,4],[True,True,False,True,True])
+        calls.append(1)
+        return [xs[0]],None
+    net=SimpleNamespace(query=nnx.Param(jnp.ones((1,1,2048))),PaliGemma=SimpleNamespace(llm=llm),
+        embed_prefix=lambda obs:(prefix,valid,jnp.zeros(4,bool)))
+    a=Pi05ODEVLMQuery.condition(net,SimpleNamespace(state=jnp.zeros((1,32)),ode_start=jnp.zeros((1,6))))
+    b=Pi05ODEVLMQuery.condition(net,SimpleNamespace(state=jnp.ones((1,32))*999,ode_start=jnp.ones((1,6))*999))
+    np.testing.assert_array_equal(a,b)
+    assert a.shape==(1,2048) and len(calls)==2
+
+def test_single_stream_gemma_query_gradient_and_prefix_isolation():
+    cfg=gemma.Config(width=32,depth=2,mlp_dim=64,num_heads=2,num_kv_heads=1,head_dim=16)
+    net=bridge.ToNNX(gemma.Module(configs=[cfg],embed_dtype='float32',adarms=False))
+    valid=jnp.array([[True,True,False,True,True]])
+    mask=pi0.make_attn_mask(valid,jnp.array([False,False,False,False,True]))
+    pos=jnp.cumsum(valid,axis=1)-1
+    x=jax.random.normal(jax.random.key(1),(1,5,32))
+    net.lazy_init([x],mask=mask,positions=pos,rngs=nnx.Rngs(2))
+    graph,state=nnx.split(net)
+    def forward(st,x):return nnx.merge(graph,st)([x],mask=mask,positions=pos)[0][0]
+    y=forward(state,x)
+    z=forward(state,x.at[:,-1].add(2))
+    # Only valid prefix outputs are meaningful; fully masked padding rows are discarded.
+    np.testing.assert_allclose(y[:,[0,1,3]],z[:,[0,1,3]],atol=1e-6)
+    changed=forward(state,x.at[:,2].set(999))
+    np.testing.assert_allclose(y[:,-1],changed[:,-1],atol=1e-6)
+    grad_st,grad_x=jax.grad(lambda st,x:jnp.sum(forward(st,x)[:,-1]*jnp.arange(32)),argnums=(0,1))(state,x)
+    assert np.linalg.norm(grad_x[:,0])>0 and np.linalg.norm(grad_x[:,-1])>0
+    assert sum(float(jnp.sum(v*v)) for v in jax.tree.leaves(grad_st))>0
+
+def test_config_and_state_tokenization_disabled():
+    c=Pi05ODEVLMQueryConfig()
+    assert c.action_horizon==8 and not c.discrete_state_input
+    with pytest.raises(ValueError):Pi05ODEVLMQueryConfig(action_horizon=5)
+    with pytest.raises(ValueError):Pi05ODEVLMQueryConfig(discrete_state_input=True)
+
+def test_strict_migration_rejects_missing_vlm_and_extra_parameters():
+    src={k:np.zeros((1,),np.float32) for k in REMOVED}
+    src.update({'PaliGemma/llm/layers/mlp_1/linear':np.ones((1,),np.float32),
+                'PaliGemma/img/w':np.ones((1,),np.float32)})
+    ref={'PaliGemma/img/w':np.zeros((1,),np.float32),'query':np.zeros((1,),np.float32),
+         'field/w':np.zeros((1,),np.float32),'grip_head/w':np.zeros((1,),np.float32)}
+    result=migrate(unflatten_dict(src,sep='/'),unflatten_dict(ref,sep='/'))
+    np.testing.assert_array_equal(result['PaliGemma']['img']['w'],[1])
+    bad=dict(src);bad.pop('PaliGemma/img/w')
+    with pytest.raises(ValueError):migrate(unflatten_dict(bad,sep='/'),unflatten_dict(ref,sep='/'))
+    bad=dict(src);bad['surprise']=np.zeros(1)
+    with pytest.raises(ValueError):migrate(unflatten_dict(bad,sep='/'),unflatten_dict(ref,sep='/'))
