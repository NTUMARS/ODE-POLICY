@@ -0,0 +1,76 @@
+import ast
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+from flax import nnx
+import jax
+import jax.numpy as jnp
+import numpy as np
+import torch
+
+from openpi.models.ode_field import GripperHead, VectorField, path_loss
+
+
+def _author_policy_file():
+    """ode_policy/policies/ode/ode_image_policy.py of this repository (the PyTorch reference)."""
+    root = Path(os.environ.get("ODE_POLICY_ROOT", Path(__file__).resolve().parents[6]))
+    return root / "ode_policy/policies/ode/ode_image_policy.py"
+
+
+def test_actual_author_gripper_forward_and_gradient():
+    source = _author_policy_file()
+    tree=ast.parse(source.read_text())
+    assignment=next(n for n in ast.walk(tree) if isinstance(n,ast.Assign)
+        and any(isinstance(t,ast.Attribute) and t.attr=='grip_head' for t in n.targets))
+    holder=SimpleNamespace(n_grippers=1)
+    scope={'self':holder,'nn':torch.nn,'cond_dim':12,'n_action_steps':8}
+    exec(compile(ast.Module(body=[assignment],type_ignores=[]),str(source),'exec'),scope)
+    author=holder.grip_head
+    port=GripperHead(12,8,rngs=nnx.Rngs(42))
+    for src,dst in ((author[0],port.hidden),(author[2],port.output)):
+        dst.kernel.value=jnp.asarray(src.weight.detach().numpy().T)
+        dst.bias.value=jnp.asarray(src.bias.detach().numpy())
+    c=np.random.default_rng(42).normal(size=(5,12)).astype(np.float32)
+    tc=torch.tensor(c,requires_grad=True)
+    logits=author(tc)
+    np.testing.assert_allclose(port(c),logits.detach(),atol=1e-6)
+    logits.square().mean().backward()
+    grad=jax.grad(lambda x:jnp.mean(port(x)**2))(c)
+    np.testing.assert_allclose(grad,tc.grad,atol=1e-6)
+    parameter_grads=nnx.grad(lambda head:jnp.mean(head(c)**2))(port).to_pure_dict()
+    for name,src in (('hidden',author[0]),('output',author[2])):
+        np.testing.assert_allclose(parameter_grads[name]['kernel'],src.weight.grad.numpy().T,atol=1e-6)
+        np.testing.assert_allclose(parameter_grads[name]['bias'],src.bias.grad.numpy(),atol=1e-6)
+
+
+def test_author_initialization_bounds_and_zero_field_output():
+    field=VectorField(12,8,64,rngs=nnx.Rngs(42))
+    for layer,fan in ((field.inp,14),(field.layers['layer_0'].lin,64),(field.layers['layer_0'].film,12)):
+        assert np.max(np.abs(layer.kernel.value))<=fan**-.5
+        assert np.max(np.abs(layer.bias.value))<=fan**-.5
+        assert np.any(layer.bias.value!=0)
+    assert np.all(field.out.kernel.value==0) and np.all(field.out.bias.value==0)
+
+
+def test_full_valid_loss_matches_author_mse_plus_bce():
+    rng=np.random.default_rng(42)
+    path,target=[rng.normal(size=(3,8,6)).astype(np.float32) for _ in range(2)]
+    logits=rng.normal(size=(3,8)).astype(np.float32)
+    grip=rng.choice([-1.,1.],size=(3,8)).astype(np.float32)
+    ref=(torch.nn.functional.mse_loss(torch.tensor(path),torch.tensor(target))/.05**2
+         +.1*torch.nn.functional.binary_cross_entropy_with_logits(torch.tensor(logits),torch.tensor((grip>0).astype(np.float32))))
+    got=path_loss(path,target,logits,grip,np.ones((3,8),bool)).mean()
+    np.testing.assert_allclose(got,ref,rtol=1e-6)
+
+
+def test_initializer_has_stable_static_graph_metadata():
+    a=VectorField(12,8,64,rngs=nnx.Rngs(42))
+    b=VectorField(12,8,64,rngs=nnx.Rngs(42))
+    assert nnx.graphdef(a)==nnx.graphdef(b)
+    # Control: otherwise identical locally-created initializer closures differ.
+    def old():
+        def initializer(key,shape,dtype=jnp.float32):
+            return jax.random.uniform(key,shape,dtype,minval=-.5,maxval=.5)
+        return nnx.Linear(4,4,kernel_init=initializer,rngs=nnx.Rngs(42))
+    assert nnx.graphdef(old())!=nnx.graphdef(old())
