@@ -0,0 +1,56 @@
+import numpy as np
+import pytest
+from scipy.spatial.transform import Rotation
+from openpi.shared.ode_pose import measured_pose, virtual_targets, track_targets, episode_targets, target_window
+
+
+def fixture(n=1000):
+    rng = np.random.default_rng(42)
+    state = rng.normal(size=(n, 8))
+    state[:, 3:6] = Rotation.random(n, random_state=rng).as_rotvec()
+    cmd = rng.uniform(-1, 1, (n, 7))
+    cmd[:, 6] = rng.choice([-1., 1.], n)
+    return state, cmd
+
+
+def test_roundtrip_full_rotations_and_float32_storage():
+    state, cmd = fixture()
+    ref = virtual_targets(state, cmd).astype(np.float32)
+    recovered = track_targets(ref, state, cmd[:, 6])
+    np.testing.assert_allclose(recovered, cmd, atol=1e-5, rtol=0)
+
+
+def test_world_rotation_composition():
+    state, cmd = fixture(1)
+    ref = virtual_targets(state, cmd)
+    measured = measured_pose(state)
+    # Noncommuting rotations must not silently become vector addition.
+    assert np.linalg.norm(ref[:, 3:] - (measured[:, 3:] + .5 * cmd[:, 3:6])) > .001
+
+
+def test_first_previous_future_gripper_and_boundary():
+    state, cmd = fixture(10)
+    cmd[:, 6] = [-1, 1] * 5
+    start, target, grip = episode_targets(state, cmd)
+    np.testing.assert_allclose(start[0], measured_pose(state[:1])[0], atol=1e-6)
+    np.testing.assert_array_equal(start[1:], target[:-1])
+    future, g, valid = target_window(target, grip, 2)
+    np.testing.assert_array_equal(future, target[2:10])
+    np.testing.assert_array_equal(g, cmd[2:10, 6])
+    assert valid.all()
+    future, g, valid = target_window(target, grip, 9)
+    np.testing.assert_array_equal(valid, [True] + [False] * 7)
+    np.testing.assert_array_equal(future[0], target[-1])
+    # A second episode resets the start, not the preceding episode's last ref.
+    start2, _, _ = episode_targets(state[3:], cmd[3:])
+    np.testing.assert_allclose(start2[0], measured_pose(state[3:4])[0], atol=1e-6)
+
+
+def test_clipping_and_nan_rejection():
+    state, cmd = fixture(2)
+    cmd *= 2
+    recovered = track_targets(virtual_targets(state, cmd), state, cmd[:, 6])
+    np.testing.assert_allclose(recovered, np.clip(cmd, -1, 1), atol=1e-6)
+    state[0, 0] = np.nan
+    with pytest.raises(ValueError):
+        virtual_targets(state, cmd)
