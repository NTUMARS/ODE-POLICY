index 0000000..6b3b8b5
--- /dev/null
+++ b/src/openpi/shared/ode_client.py
@@ -0,0 +1,41 @@
+"""Per-episode ODE state, held by client, never shared by policy service."""
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from openpi.shared.ode_pose import measured_pose, track_targets
+
+
+class ODEReferenceState:
+    def __init__(self):
+        self.reference = None
+        self.previous_quat = None
+
+    def observe(self, state):
+        state = np.asarray(state, np.float32)
+        if state.shape != (8,) or not np.isfinite(state).all():
+            raise ValueError('Expected finite current robot state8')
+        q = Rotation.from_rotvec(state[3:6]).as_quat().astype(np.float32)
+        if self.previous_quat is None:
+            if q[np.argmax(np.abs(q))] < 0:
+                q *= -1
+        elif np.dot(q,self.previous_quat) < 0:
+            q *= -1
+        self.previous_quat = q.copy()
+        if self.reference is None:
+            self.reference = measured_pose(state[None])[0].astype(np.float32)
+        grip = 1-2*np.clip(np.abs(state[6:8]).mean()/0.04,0,1)
+        return {'ode_start':self.reference.copy(),
+                'ode_proprio':np.r_[state[:3],q,grip].astype(np.float32)}
+
+    def command(self, target, state):
+        target = np.asarray(target,np.float32)
+        if target.shape != (7,) or not np.isfinite(target).all():
+            raise ValueError('Expected finite pose6+gripper target')
+        return track_targets(target[None,:6],np.asarray(state)[None],target[None,6])[0]
+
+    def commit_executed(self, target):
+        """Call only after env.step succeeds; predicted-but-unexecuted tail is ignored."""
+        target = np.asarray(target,np.float32)
+        if target.shape != (7,) or not np.isfinite(target).all():
+            raise ValueError('Expected finite executed reference target')
+        self.reference = target[:6].copy()
