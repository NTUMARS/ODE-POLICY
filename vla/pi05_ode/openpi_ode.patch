index 0000000..19d806e
--- /dev/null
+++ b/src/openpi/models/pi05_ode_vlmquery.py
@@ -0,0 +1,44 @@
+"""ODE head conditioned by one learned readout token in the VLM; no action expert or flow-time branch."""
+import dataclasses
+from flax import nnx
+from flax.nnx import bridge
+import jax
+import jax.numpy as jnp
+from openpi.models import gemma, model, ode_field, pi0, siglip
+from openpi.models.pi05_ode import Pi05ODE, Pi05ODEConfig
+
+@dataclasses.dataclass(frozen=True)
+class Pi05ODEVLMQueryConfig(Pi05ODEConfig):
+    action_horizon: int = 8
+    def __post_init__(self):
+        super().__post_init__()
+        if self.action_horizon != 8 or self.paligemma_variant != 'gemma_2b':
+            raise ValueError('The VLM-query ODE head requires Gemma 2B and H = 8')
+    def create(self, rng):
+        return Pi05ODEVLMQuery(self, nnx.Rngs(rng))
+
+class Pi05ODEVLMQuery(Pi05ODE):
+    def __init__(self, config, rngs):
+        # Do not call Pi05ODE.__init__: it allocates an unwanted expert.
+        model.BaseModel.__init__(self,config.action_dim,config.action_horizon,config.max_token_len)
+        vlm=gemma.get_config(config.paligemma_variant)
+        assert vlm.width == 2048
+        llm=bridge.ToNNX(gemma.Module(configs=[vlm],embed_dtype=config.dtype,adarms=False))
+        llm.lazy_init(rngs=rngs,method='init',use_adarms=[False])
+        img=bridge.ToNNX(siglip.Module(num_classes=vlm.width,variant='So400m/14',pool_type='none',scan=True,dtype_mm=config.dtype))
+        img.lazy_init(next(iter(config.fake_obs().images.values())),train=False,rngs=rngs)
+        self.PaliGemma=nnx.Dict(llm=llm,img=img)
+        self.query=nnx.Param(jax.random.normal(rngs.params(),(1,1,2048))*0.02)
+        self.field=ode_field.VectorField(2048,8,config.field_width,rngs=rngs)
+        self.grip_head=ode_field.GripperHead(2048,8,rngs=rngs)
+        self.deterministic=True
+
+    def condition(self, observation):
+        prefix,valid,ar=self.embed_prefix(observation)
+        query=jnp.broadcast_to(self.query.value,(prefix.shape[0],1,2048)).astype(prefix.dtype)
+        tokens=jnp.concatenate((prefix,query),axis=1)
+        valid=jnp.concatenate((valid,jnp.ones((prefix.shape[0],1),bool)),axis=1)
+        # Query reads prefix and itself; prefix cannot read the query.
+        ar=jnp.concatenate((ar,jnp.ones((1,),bool)))
+        (out,),_=self.PaliGemma.llm([tokens],mask=pi0.make_attn_mask(valid,ar),positions=jnp.cumsum(valid,axis=1)-1)
+        return out[:,-1].astype(jnp.float32)
diff --git a/src/openpi/models/pi05_ode_vlmquery_test.py b/src/openpi/models/pi05_ode_vlmquery_test.py
