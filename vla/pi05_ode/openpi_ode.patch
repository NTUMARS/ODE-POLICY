new file mode 100644
index 0000000..1e9dd72
--- /dev/null
+++ b/src/openpi/shared/ode_pose.py
@@ -0,0 +1,74 @@
+"""LIBERO virtual targets, in physical units (CPU preprocessing/client only).
+
+Port of the pinned author's pose.py/build_ode_zarr.py. This module accepts only
+robot state and commanded actions, never object state or future observations.
+The current OpenPI state layout is xyz, world rotation-vector, two finger qpos.
+"""
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+POS_SCALE = 0.05
+ROT_SCALE = 0.5
+CANONICAL_QUAT = np.array([0.99959104, -0.00150985, -0.02851977, 0.00144439])
+REFERENCE = Rotation.from_quat(CANONICAL_QUAT)
+
+
+def _array(value, dim):
+    value = np.asarray(value, dtype=np.float64)
+    if value.ndim != 2 or value.shape[1] != dim or not np.isfinite(value).all():
+        raise ValueError(f'Expected finite (N,{dim}), got {value.shape}')
+    return value
+
+
+def measured_pose(state):
+    state = _array(state, 8)
+    relative = (Rotation.from_rotvec(state[:, 3:6]) * REFERENCE.inv()).as_rotvec()
+    return np.concatenate([state[:, :3], relative], axis=-1)
+
+
+def virtual_targets(state, commands):
+    state, commands = _array(state, 8), _array(commands, 7)
+    if len(state) != len(commands):
+        raise ValueError('State/command rows must match')
+    cmd = np.clip(commands, -1, 1)
+    position = state[:, :3] + POS_SCALE * cmd[:, :3]
+    rotation = Rotation.from_rotvec(ROT_SCALE * cmd[:, 3:6]) * Rotation.from_rotvec(state[:, 3:6])
+    relative = (rotation * REFERENCE.inv()).as_rotvec()
+    return np.concatenate([position, relative], axis=-1)
+
+
+def track_targets(targets, current_state, gripper):
+    """Gain=1, no velocity feedforward. Output actual normalized OSC commands."""
+    targets, state = _array(targets, 6), _array(current_state, 8)
+    grip = np.asarray(gripper, dtype=np.float64).reshape(-1, 1)
+    if len(targets) != len(state) or len(grip) != len(state) or not np.isfinite(grip).all():
+        raise ValueError('Target/state/gripper rows must match and be finite')
+    desired = Rotation.from_rotvec(targets[:, 3:6]) * REFERENCE
+    error = (desired * Rotation.from_rotvec(state[:, 3:6]).inv()).as_rotvec()
+    cmd = np.concatenate([(targets[:, :3] - state[:, :3]) / POS_SCALE, error / ROT_SCALE, grip], -1)
+    return np.clip(cmd, -1, 1).astype(np.float32)
+
+
+def episode_targets(state, commands):
+    """For observation t: start=r[t-1], target=r[t], gripper=u[t,6].
+
+    Input must be exactly ONE episode. Retains final command's target (unlike
+    shifted storage which drops it); future windows are masked at the boundary.
+    """
+    state, commands = _array(state, 8), _array(commands, 7)
+    if len(state) == 0:
+        raise ValueError('Empty episode')
+    target = virtual_targets(state, commands)
+    start = np.concatenate([measured_pose(state[:1]), target[:-1]], axis=0)
+    return start.astype(np.float32), target.astype(np.float32), np.clip(commands[:, 6], -1, 1).astype(np.float32)
+
+
+def target_window(target, gripper, index, horizon=8):
+    target = _array(target, 6)
+    gripper = np.asarray(gripper)
+    if horizon <= 0 or not 0 <= index < len(target) or gripper.shape != (len(target),):
+        raise ValueError('Invalid window or gripper shape')
+    ids = index + np.arange(horizon)
+    valid = ids < len(target)
+    ids = np.minimum(ids, len(target) - 1)
+    return target[ids].astype(np.float32), gripper[ids].astype(np.float32), valid
