+    stats = limits_stats(values)
+    np.testing.assert_allclose((values-stats.mean)/stats.std, [[-1, 0], [1, 0]])
+
+
+def test_pose_and_start_share_norm_and_gripper_unchanged():
+    pose = limits_stats(np.array([np.zeros(6), np.arange(1, 7)], np.float32))
+    stats = {'ode_start':pose,'state':NormStats(mean=np.zeros(8),std=np.ones(8)),
+             'actions':NormStats(mean=np.r_[pose.mean,0],std=np.r_[pose.std,1])}
+    data = {'ode_start':np.ones(6),'state':np.ones(8),'actions':np.ones((8,7))}
+    got = ODENormalize(stats)(data)
+    np.testing.assert_allclose(got['ode_start'], got['actions'][0,:6])
+    np.testing.assert_allclose(got['ode_pose_scale'], 1/pose.std)
+    np.testing.assert_array_equal(got['actions'][:,6], 1)
+    np.testing.assert_allclose(ODEUnnormalize(stats)(got)['actions'],data['actions'])
+
+
+def test_cache_episode_boundary_and_index_identity(tmp_path):
+    path = tmp_path/'cache.npz'
+    ep = np.array([0]*10+[1]*2)
+    frame = np.r_[np.arange(10),np.arange(2)]
+    actions = np.arange(12*7).reshape(12,7).astype(np.float32)
+    np.savez(path,episode_index=ep,frame_index=frame,actions=actions,start=np.zeros((12,6)),
+             proprio=np.zeros((12,8)),episode_end=np.array([10]*10+[12]*2))
+    dataset = [{'episode_index':e,'frame_index':f} for e,f in zip(ep,frame,strict=True)]
+    wrapped = ODETargetDataset(dataset,path)
+    np.testing.assert_array_equal(wrapped[2]['actions'],actions[2:10])
+    np.testing.assert_array_equal(wrapped[9]['actions'],np.broadcast_to(actions[9],(8,7)))
+    np.testing.assert_array_equal(wrapped[9]['actions_is_pad'],[False]+[True]*7)
+    np.testing.assert_array_equal(wrapped[10]['actions'][:2],actions[10:])
+    dataset[0]['frame_index']=99
+    with pytest.raises(ValueError):
+        wrapped[0]
+
+
+def test_proprio_quaternion_and_mirrored_fingers():
+    state = np.zeros((2,8),np.float32)
+    state[:,3] = [3.13,-3.13]
+    state[:,6:] = [[.04,-.04],[0,0]]
+    converted = proprioception(state)
+    assert np.dot(converted[0,3:7],converted[1,3:7]) > .99
+    np.testing.assert_array_equal(converted[:,-1],[-1,1])
+    one = proprioception(state[1:],previous_quat=converted[0,3:7])
+    np.testing.assert_allclose(one,converted[1:])
