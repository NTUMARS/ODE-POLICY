index 0000000..5a1118e
--- /dev/null
+++ b/src/openpi/shared/ode_data.py
@@ -0,0 +1,95 @@
+"""Auditable episode-local supervision and author's linear normalization."""
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from openpi.shared.normalize import NormStats
+
+
+def proprioception(state, previous_quat=None):
+    """Convert ONE episode/contiguous sequence. Caller owns quaternion continuity."""
+    state = np.asarray(state, dtype=np.float32)
+    if state.ndim != 2 or state.shape[1] != 8 or not np.isfinite(state).all():
+        raise ValueError("Expected finite (T,8) OpenPI state")
+    quat = Rotation.from_rotvec(state[:, 3:6]).as_quat().astype(np.float32)
+    previous = previous_quat
+    for q in quat:
+        if previous is None:
+            if q[np.argmax(np.abs(q))] < 0:
+                q *= -1
+        elif np.dot(q, previous) < 0:
+            q *= -1
+        previous = q
+    grip = 1 - 2*np.clip(np.abs(state[:, 6:8]).mean(-1)/0.04, 0, 1)
+    return np.concatenate([state[:, :3], quat, grip[:, None]], -1)
+
+
+def limits_stats(values):
+    """Exact author limits-mode affine map, stored in OpenPI's asset schema.
+
+    mean/std here encode center/inverse slope, NOT sample moments. Must use
+    ODENormalize, not standard OpenPI Normalize (which adds epsilon).
+    """
+    values = np.asarray(values, dtype=np.float32)
+    low, high = values.min(axis=0), values.max(axis=0)
+    span = high-low
+    constant = span < 1e-4
+    scale = 2/np.where(constant, 2., span)
+    offset = np.where(constant, -low, -1-scale*low)
+    return NormStats(mean=-offset/scale, std=1/scale)
+
+
+class ODENormalize:
+    def __init__(self, stats):
+        self.stats = stats
+
+    def __call__(self, data):
+        if self.stats is None or not {'state', 'actions', 'ode_start'} <= self.stats.keys():
+            raise ValueError("Missing ODE normalization assets")
+        result = dict(data)
+        for key in ('state', 'actions', 'ode_start'):
+            if key in result:
+                stat = self.stats[key]
+                result[key] = ((np.asarray(result[key])-stat.mean)/stat.std).astype(np.float32)
+        result['ode_pose_scale'] = (1/self.stats['ode_start'].std).astype(np.float32)
+        return result
+
+
+class ODEUnnormalize:
+    def __init__(self, stats):
+        self.stats = stats
+
+    def __call__(self, data):
+        result = dict(data)
+        stat = self.stats['actions']
+        result['actions'] = np.asarray(data['actions'])[..., :7]*stat.std+stat.mean
+        return result
+
+
+class ODETargetDataset:
+    """Keep original LeRobot images/indices; replace only supervision from cache."""
+    def __init__(self, dataset, cache_path, horizon=8):
+        self.horizon = horizon
+        self.dataset = dataset
+        with np.load(cache_path, allow_pickle=False) as cache:
+            self.cache = {k: cache[k] for k in cache.files}
+        if len(dataset) != len(self.cache['episode_index']):
+            raise ValueError('Dataset/cache row count mismatch')
+
+    def __len__(self):
+        return len(self.dataset)
+
+    def __getitem__(self, index):
+        item = dict(self.dataset[index])
+        cache = self.cache
+        for key in ('episode_index', 'frame_index'):
+            if int(item[key]) != int(cache[key][index]):
+                raise ValueError(f'Dataset/cache index mismatch: {key} row {index}')
+        ids = index + np.arange(self.horizon)
+        end = int(cache['episode_end'][index])
+        valid = ids < end
+        ids = np.minimum(ids, end-1)
+        item['actions'] = cache['actions'][ids]
+        item['actions_is_pad'] = ~valid
+        item['ode_start'] = cache['start'][index]
+        item['ode_proprio'] = cache['proprio'][index]
+        return item
