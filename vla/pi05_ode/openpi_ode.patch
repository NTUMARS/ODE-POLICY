diff --git a/src/openpi/training/ode_weight_loader.py b/src/openpi/training/ode_weight_loader.py
new file mode 100644
index 0000000..6a5c814
--- /dev/null
+++ b/src/openpi/training/ode_weight_loader.py
@@ -0,0 +1,52 @@
+"""Strict official pi05 -> ODE (with action expert) migration, never used to resume ODE checkpoints."""
+import dataclasses
+import logging
+
+from flax.traverse_util import flatten_dict, unflatten_dict
+import numpy as np
+from scipy.special import expit
+
+from openpi.models import model
+from openpi.shared import download
+
+REMOVED = frozenset(f"{layer}/{param}" for layer in (
+    "time_mlp_in", "time_mlp_out", "action_in_proj", "action_out_proj",
+) for param in ("kernel", "bias"))
+NEW_ROOTS = frozenset(("query", "z_ada", "field", "grip_head"))
+
+
+def migrate(loaded, reference):
+    src, ref = flatten_dict(loaded, sep="/"), flatten_dict(reference, sep="/")
+    extra = set(src)-set(ref)
+    missing = set(ref)-set(src)
+    expected_new = (NEW_ROOTS - {'query'}) | {'query_in', 'query_out'} if 'query_in/kernel' in ref else NEW_ROOTS
+    if extra != REMOVED:
+        raise ValueError(f"Unexpected removed parameters: {extra ^ REMOVED}")
+    if any(k.split("/")[0] not in expected_new for k in missing):
+        raise ValueError(f"Unexpected missing parameters: {sorted(missing)}")
+    if set(k.split("/")[0] for k in missing) != expected_new:
+        raise ValueError("Missing expected new ODE parameter groups")
+    result = dict(ref)
+    for key in set(src) & set(ref):
+        if src[key].shape != ref[key].shape:
+            raise ValueError(f"Shape mismatch for {key}: {src[key].shape} != {ref[key].shape}")
+        result[key] = src[key].astype(ref[key].dtype)
+    width = ref["z_ada"].shape[0]
+    # At t=0, sin=0 and cos=1; no runtime time network is retained.
+    z = np.concatenate([np.zeros(width//2), np.ones(width//2)]).astype(np.float32)
+    for layer in ("time_mlp_in", "time_mlp_out"):
+        z = z @ src[f"{layer}/kernel"].astype(np.float32) + src[f"{layer}/bias"].astype(np.float32)
+        z = z * expit(z)
+    if z.shape != ref["z_ada"].shape or not np.isfinite(z).all():
+        raise ValueError("Invalid migrated adaRMS condition")
+    result["z_ada"] = z.astype(ref["z_ada"].dtype)
+    logging.info("ODE migration: inherited=%s removed=%s new=%s", len(set(src)&set(ref)), sorted(extra), sorted(missing))
+    return unflatten_dict(result, sep="/")
+
+
+@dataclasses.dataclass(frozen=True)
+class ODEBaseWeightLoader:
+    params_path: str
+
+    def load(self, params):
+        return migrate(model.restore_params(download.maybe_download(self.params_path), restore_type=np.ndarray), params)
diff --git a/src/openpi/training/ode_weight_loader_test.py b/src/openpi/training/ode_weight_loader_test.py
new file mode 100644
index 0000000..26c2787
--- /dev/null
+++ b/src/openpi/training/ode_weight_loader_test.py
@@ -0,0 +1,46 @@
+import copy
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from openpi.models.pi0 import posemb_sincos
+from openpi.training.ode_weight_loader import migrate
+
+
+def fixture():
+    rng = np.random.default_rng(42)
+    dense = lambda: {"kernel": rng.normal(size=(4, 4)).astype(np.float32), "bias": rng.normal(size=4).astype(np.float32)}
+    source = {"PaliGemma": {"dummy": np.ones(4, np.float32)}, **{k: dense() for k in (
+        "time_mlp_in", "time_mlp_out", "action_in_proj", "action_out_proj",
+    )}}
+    target = {"PaliGemma": {"dummy": np.zeros(4, np.float32)}, "z_ada": np.zeros(4, np.float32),
+              "query": np.ones((1, 1, 4), np.float32), "field": {"new": np.ones(3, np.float32)},
+              "grip_head": {"new": np.ones(4, np.float32)}}
+    return source, target
+
+
+def test_one_time_ada_initialization_matches_pretrained_time_path():
+    source, target = fixture()
+    got = migrate(source, target)
+    x = posemb_sincos(jnp.zeros((1,)), 4, 4e-3, 4.)
+    for key in ("time_mlp_in", "time_mlp_out"):
+        x = jax.nn.silu(x @ source[key]["kernel"] + source[key]["bias"])
+    np.testing.assert_allclose(got["z_ada"], x[0], atol=1e-6)
+    np.testing.assert_array_equal(got["PaliGemma"]["dummy"], source["PaliGemma"]["dummy"])
+    assert not set(got) & {"time_mlp_in", "time_mlp_out", "action_in_proj", "action_out_proj"}
+
+
+@pytest.mark.parametrize("mutation", ["extra", "missing", "shape"])
+def test_migration_rejects_unexplained_drift(mutation):
+    source, target = fixture()
+    source = copy.deepcopy(source)
+    if mutation == "extra":
+        source["surprise"] = np.ones(1)
+    elif mutation == "missing":
+        del source["PaliGemma"]
+    else:
+        source["PaliGemma"]["dummy"] = np.ones(5)
+    with pytest.raises(ValueError):
+        migrate(source, target)
diff --git a/src/openpi/training/vlmquery_weight_loader.py b/src/openpi/training/vlmquery_weight_loader.py
new file mode 100644
index 0000000..fb2e8e9
--- /dev/null
+++ b/src/openpi/training/vlmquery_weight_loader.py
@@ -0,0 +1,32 @@
+"""Explicit, strict official pi05 -> VLM-only ODE parameter migration."""
+import dataclasses
+import numpy as np
+from flax.traverse_util import flatten_dict,unflatten_dict
+from openpi.models import model
+from openpi.shared import download
+from openpi.training.ode_weight_loader import REMOVED
+EXPERT_MODULES=frozenset(('attn_vec_einsum_1','q_einsum_1','kv_einsum_1','mlp_1','pre_attention_norm_1','pre_ffw_norm_1','final_norm_1'))
+def expert_key(key):
+    return key.startswith('PaliGemma/llm/') and bool(set(key.split('/')) & EXPERT_MODULES)
+def migrate(loaded,reference):
+    src,ref=flatten_dict(loaded,sep='/'),flatten_dict(reference,sep='/')
+    removed={k for k in src if expert_key(k)} | set(REMOVED)
+    if not {k for k in src if expert_key(k)}:
+        raise ValueError('Expected official checkpoint with expert parameters')
+    if set(src)-set(ref) != removed or not removed <= set(src):
+        raise ValueError('Unexpected removed/base parameter keys')
+    missing=set(ref)-set(src)
+    if {k.split('/')[0] for k in missing} != {'query','field','grip_head'}:
+        raise ValueError('Unexpected new/missing parameter groups')
+    if any(expert_key(k) for k in ref) or 'z_ada' in ref:
+        raise ValueError('Unexpected expert/time parameters in target')
+    result=dict(ref)
+    for k in set(src)&set(ref):
+        if src[k].shape != ref[k].shape:raise ValueError(f'Shape mismatch: {k}')
+        result[k]=src[k].astype(ref[k].dtype)
+    return unflatten_dict(result,sep='/')
+@dataclasses.dataclass(frozen=True)
+class VLMQueryWeightLoader:
+    params_path: str
+    def load(self,params):
+        return migrate(model.restore_params(download.maybe_download(self.params_path),restore_type=np.ndarray),params)
