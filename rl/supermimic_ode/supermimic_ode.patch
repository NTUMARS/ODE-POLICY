new file mode 100644
index 0000000..20b26aa
--- /dev/null
+++ b/scripts/ppo/eval_ppo.py
@@ -0,0 +1,47 @@
+"""Appendix F benchmark of PPO-Sim checkpoints written by scripts/ppo/train_ppo.py.
+
+  env -u PYTHONPATH uv run python scripts/ppo/eval_ppo.py logs/ppo_s0/ckpt_*.jit [--no-anchor-obs]
+
+Writes logs/<run>/benchmark_ckpt_XX.json in the same format as scripts/eval_benchmark.py, plus the checkpoint's
+training time and env steps (ckpt_XX.json).
+"""
+
+import json
+import sys
+from pathlib import Path
+
+import torch
+
+from supermimic.envs.mdp.motion_library import discover_npz
+from supermimic.eval.benchmark import run_benchmark, save_results, summarize
+
+
+class JitActor(torch.nn.Module):
+    """The PPO actor (observation normalizer + MLP, deterministic) on the concatenated [policy, goal] groups."""
+
+    def __init__(self, path: str, device: str):
+        super().__init__()
+        self.net = torch.jit.load(path, map_location=device)
+
+    def forward(self, obs_hist: torch.Tensor, goal: torch.Tensor) -> torch.Tensor:
+        return self.net(torch.cat([obs_hist, goal], dim=-1))
+
+
+def main(args: list[str]) -> None:
+    anchor_obs = "--no-anchor-obs" not in args
+    files = [str(f) for f in discover_npz(Path("data/npz/lafan1"))]
+    for p in (Path(a) for a in args if not a.startswith("--")):
+        res = run_benchmark(JitActor(str(p), "cuda:0"), files, device="cuda:0", anchor_obs=anchor_obs)
+        s = summarize(res)
+        print(f"=== {p}\n{s['clips']} clips | failed {s['failed']} | mean norm return {s['mean_norm_return']:.4f}")
+        if "smooth" in s:
+            print("executed smoothness (step-weighted): " + "  ".join(f"{k} {v:.4g}" for k, v in s["smooth"].items()))
+        out = p.parent / f"benchmark_{p.stem}.json"
+        save_results(res, out)
+        d = json.loads(out.read_text())
+        d["ckpt_meta"] = json.loads(p.with_suffix(".json").read_text())
+        out.write_text(json.dumps(d, indent=1))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
diff --git a/scripts/ppo/train_ppo.py b/scripts/ppo/train_ppo.py
new file mode 100644
index 0000000..3e75b2d
--- /dev/null
+++ b/scripts/ppo/train_ppo.py
@@ -0,0 +1,109 @@
+"""PPO-Sim baseline: model-free PPO on the SuperMimic tracking env (the paper's §4.1 controlled comparison).
+
+  env -u PYTHONPATH uv run python scripts/ppo/train_ppo.py --name ppo_s0 --seed 0 --hours 3
+
+Same env as sm-train (actions, observations including the anchor-relative pose unless --no-anchor-obs, rewards,
+terminations, domain randomization, adaptive clip sampling, 40 LAFAN1 clips). PPO samples its own Gaussian actions, so the env's execution noise is off.
+Hyperparameters: BeyondMimic / mjlab G1 tracking PPO, 8192 envs (the paper's PPO-Sim setting). Network sizes follow
+the paper's "same actor / critic sizes": actor MLP (2048, 1024, 512, 256), critic MLP (256, 128).
+
+Logs to logs/<name>/: tb with the same tags as sm-train (time/hours, train/episode_norm_return), and every
+--ckpt-hours a TorchScript actor ckpt_<k>.jit (deterministic, normalizer included) plus ckpt_<k>.json (hours,
+env steps) for scripts/ppo/eval_ppo.py.
+"""
+
+import argparse
+import dataclasses
+import json
+import time
+from pathlib import Path
+
+import torch
+from torch.utils.tensorboard import SummaryWriter
+
+from mjlab.rl.runner import MjlabOnPolicyRunner
+from mjlab.rl.vecenv_wrapper import RslRlVecEnvWrapper
+from mjlab.tasks.tracking.config.g1.rl_cfg import unitree_g1_tracking_ppo_runner_cfg
+from supermimic.envs import SuperMimicEnvCfgArgs, make_env
+from supermimic.envs.mdp.motion_library import discover_npz
+from supermimic.envs.mdp.rewards import TrackingRewardCfg
+
+ACTOR_OBS = ("policy", "goal")
+
+
+class LoggingEnv(RslRlVecEnvWrapper):
+    """Adds sm-train's training-return logging (normalized by the maximum step reward) per vectorized step."""
+
+    def __init__(self, env, writer: SummaryWriter, max_step_reward: float, log_every: int = 50):
+        super().__init__(env)
+        self.writer, self.max_r, self.log_every = writer, max_step_reward, log_every
+        self.ret = torch.zeros(self.num_envs, device=self.device)
+        self.len = torch.zeros(self.num_envs, device=self.device)
+        self.done_ret: list[float] = []
+        self.steps = 0
+        self.t0 = time.time()
+
+    def step(self, actions):
+        obs, rew, dones, extras = super().step(actions)
+        self.ret += rew
+        self.len += 1
+        if dones.any():
+            ids = dones.nonzero().squeeze(-1)
+            self.done_ret.extend((self.ret[ids] / (self.max_r * self.len[ids].clamp_min(1))).tolist())
+            self.ret[ids] = 0
+            self.len[ids] = 0
+        self.steps += 1
+        if self.steps % self.log_every == 0:
+            self.writer.add_scalar("time/hours", (time.time() - self.t0) / 3600, self.steps)
+            if self.done_ret:
+                self.writer.add_scalar("train/episode_norm_return", sum(self.done_ret) / len(self.done_ret), self.steps)
+                self.done_ret = []
+        return obs, rew, dones, extras
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--name", required=True)
+    p.add_argument("--seed", type=int, default=0)
+    p.add_argument("--hours", type=float, default=3.0)
+    p.add_argument("--ckpt-hours", type=float, default=0.35)
+    p.add_argument("--num-envs", type=int, default=8192)
+    p.add_argument("--npz-dir", default="data/npz/lafan1")
+    p.add_argument("--no-anchor-obs", action="store_true", help="drop the anchor-relative observation (on by default)")
+    a = p.parse_args()
+    out = Path("logs") / a.name
+    out.mkdir(parents=True, exist_ok=True)
+    torch.manual_seed(a.seed)
+    files = [str(f) for f in discover_npz(Path(a.npz_dir))]
+    env = make_env(SuperMimicEnvCfgArgs(npz_files=files, num_envs=a.num_envs, action_noise_std=0.0, record_transitions=False,
+                                        anchor_obs=not a.no_anchor_obs, seed=a.seed), device="cuda:0")
+    writer = SummaryWriter(str(out / "tb"))
+    venv = LoggingEnv(env, writer, TrackingRewardCfg().max_step_reward)
+
+    cfg = unitree_g1_tracking_ppo_runner_cfg()
+    cfg.seed = a.seed
+    cfg.obs_groups = {"actor": ACTOR_OBS, "critic": ACTOR_OBS}
+    cfg.actor = dataclasses.replace(cfg.actor, hidden_dims=(2048, 1024, 512, 256))
+    cfg.critic = dataclasses.replace(cfg.critic, hidden_dims=(256, 128))
+    cfg.logger = "tensorboard"
+    cfg.save_interval = 10**9  # checkpoints are written here, on a wall-clock schedule
+    train_cfg = dataclasses.asdict(cfg)
+    runner = MjlabOnPolicyRunner(venv, train_cfg, log_dir=str(out / "rsl_rl"), device="cuda:0")
+    (out / "config.json").write_text(json.dumps({"args": vars(a), "runner": train_cfg}, indent=1, default=str))
+
+    t0, k, first = time.time(), 1, True
+    while (time.time() - t0) / 3600 < a.hours:
+        runner.learn(num_learning_iterations=20, init_at_random_ep_len=first)
+        first = False
+        hrs = (time.time() - t0) / 3600
+        if hrs >= k * a.ckpt_hours or hrs >= a.hours:
+            runner.export_policy_to_jit(str(out), f"ckpt_{k:02d}.jit")
+            (out / f"ckpt_{k:02d}.json").write_text(json.dumps({"hours": hrs, "env_steps": venv.steps * a.num_envs,
+                                                                "iteration": runner.current_learning_iteration}))
+            print(f"[ckpt] {k:02d} at {hrs:.2f} h, {venv.steps} vectorized steps", flush=True)
+            k += 1
+    writer.flush()
+
+
+if __name__ == "__main__":
+    main()
