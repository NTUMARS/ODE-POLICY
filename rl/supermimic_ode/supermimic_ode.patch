diff --git a/tests/test_ode_policy.py b/tests/test_ode_policy.py
new file mode 100644
index 0000000..113be0d
--- /dev/null
+++ b/tests/test_ode_policy.py
@@ -0,0 +1,37 @@
+"""ODE actor: one Euler step from the previous clean action, read from the newest frame of the history."""
+
+import torch
+
+from supermimic.policy.nets import ACT_DIM, GOAL_DIM, Policy, PolicyCfg
+from supermimic.world_model.heads import OBS_DIM, flatten_history_term_major
+
+
+def _inputs(n=5, h=10):
+    torch.manual_seed(0)
+    hist = torch.randn(h, n, OBS_DIM)  # (H, N, 93) oldest -> newest; the action term is the last ACT_DIM of each frame
+    return hist, flatten_history_term_major(hist), torch.randn(n, GOAL_DIM)
+
+
+def test_ode_actor_steps_from_newest_previous_action():
+    hist, obs_flat, goal = _inputs()
+    mlp = Policy(PolicyCfg())
+    ode = Policy(PolicyCfg(actor="ode"))
+    ode.load_state_dict(mlp.state_dict())  # same parameters, only the output is interpreted differently
+    a_prev = hist[-1, :, OBS_DIM - ACT_DIM :]
+    assert torch.allclose(obs_flat[:, -ACT_DIM:], a_prev)
+    assert torch.allclose(ode(obs_flat, goal), a_prev + mlp(obs_flat, goal), atol=1e-6)
+    # small last-layer gain: the initial ODE policy nearly holds the previous action
+    assert (ode(obs_flat, goal) - a_prev).abs().max() < 0.5
+
+
+def test_ode_actor_clamps():
+    hist, obs_flat, goal = _inputs()
+    hist[-1, :, OBS_DIM - ACT_DIM :] = 3.0  # previous action outside the bound below
+    obs_flat = flatten_history_term_major(hist)
+    pol = Policy(PolicyCfg(actor="ode", ode_dmax=0.01, ode_amax=(2.0,) * ACT_DIM))
+    torch.nn.init.constant_(pol.decoder.mlp.net[-1].bias, 1.0)  # large raw change, clamped to dmax
+    a = pol(obs_flat, goal)
+    assert torch.allclose(a, torch.full_like(a, 2.0))
+    pol = Policy(PolicyCfg(actor="ode", ode_dmax=0.01))
+    torch.nn.init.constant_(pol.decoder.mlp.net[-1].bias, 1.0)
+    assert ((pol(obs_flat, goal) - 3.0).abs() <= 0.01 + 1e-6).all()
